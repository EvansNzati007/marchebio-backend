generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  PRODUCTEUR
  ACHETEUR
  ADMIN
}

enum StatutCommande {
  NOUVELLE
  PREPAREE
  LIVREE
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  userName String
  password String
  adresse  String?
  numTel   String  @unique
  role     Role    @default(ACHETEUR)

  products  Product[]
  commandes Commande[]

  evaluationsDonnees Evaluation[] @relation("EvaluationsDonnees")
  evaluationsRecues  Evaluation[] @relation("EvaluationsRecues")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  quantity    Int
  photo       String?

  produteurId Int
  user        User @relation(fields: [produteurId], references: [id])

  ligneCommandes LigneCommande[]
}

model Commande {
  id           Int            @id @default(autoincrement())
  dateCommande DateTime       @default(now())
  montantTotal Float
  statut       StatutCommande @default(NOUVELLE)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  ligneCommandes LigneCommande[]
  evaluations    Evaluation[]
}

model LigneCommande {
  id           Int   @id @default(autoincrement())
  quantity     Int
  prixUnitaire Float

  productId  Int
  commandeId Int
  product    Product  @relation(fields: [productId], references: [id])
  commande   Commande @relation(fields: [commandeId], references: [id])
}

model Evaluation {
  id          Int     @id @default(autoincrement())
  note        Int
  commentaire String?

  userId       Int
  producteurId Int
  commandeId   Int?

  user       User      @relation("EvaluationsDonnees", fields: [userId], references: [id])
  producteur User      @relation("EvaluationsRecues", fields: [producteurId], references: [id])
  commande   Commande? @relation(fields: [commandeId], references: [id])
}
