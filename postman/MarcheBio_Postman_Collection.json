{
  "info": {
    "name": "MarchéBio - API Backend",
    "description": "Collection de test pour l'API MarchéBio. Le token JWT est automatiquement sauvegardé dans la variable {{access_token}} après un register ou un login réussi — pas besoin de le copier/coller à la main.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "marchebio-collection-v1"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Acheteur",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"acheteur1@test.com\",\n  \"userName\": \"Acheteur Test\",\n  \"password\": \"123456\",\n  \"numTel\": \"077000001\",\n  \"adresse\": \"Libreville, Owendo\",\n  \"role\": \"ACHETEUR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Crée un compte Acheteur. Sauvegarde automatiquement le token reçu."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "        console.log('Token sauvegardé automatiquement ✅');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Statut 200 ou 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('La réponse contient un access_token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register - Producteur",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"producteur1@test.com\",\n  \"userName\": \"Producteur Test\",\n  \"password\": \"123456\",\n  \"numTel\": \"077000002\",\n  \"adresse\": \"Ntoum\",\n  \"role\": \"PRODUCTEUR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Crée un compte Producteur. Sauvegarde automatiquement le token reçu."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "        console.log('Token sauvegardé automatiquement ✅');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Statut 200 ou 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"acheteur1@test.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Connecte un utilisateur existant. Sauvegarde automatiquement le token reçu."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "        console.log('Token sauvegardé automatiquement ✅');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Statut 200 ou 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('La réponse contient un access_token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});",
                  "",
                  "pm.test('Mauvais identifiants → pas de token', function () {",
                  "    if (pm.response.code === 401) {",
                  "        pm.expect(pm.response.json()).to.have.property('message');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Mauvais mot de passe (doit échouer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"acheteur1@test.com\",\n  \"password\": \"mauvaispassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Test négatif : vérifie que la connexion échoue bien avec un mauvais mot de passe (401 attendu)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Doit retourner 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Exemple - Route protégée (à activer une fois les guards prêts)",
      "item": [
        {
          "name": "Exemple GET avec token automatique",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            },
            "description": "Exemple de requête protégée : utilise automatiquement le token sauvegardé lors du dernier register/login. Adapte l'URL au vrai endpoint quand il existera."
          }
        }
      ]
    }
  ]
}
